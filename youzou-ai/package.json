{
  "name": "youzou-ai",
  "version": "1.0.0",
  "description": "遊走 AI - Intelligent travel companion for finding best flight and hotel prices",
  "main": "index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm start",
    "mobile": "cd mobile && npm start",
    "build": "npm run build:client && npm run build:mobile",
    "build:client": "cd client && npm run build",
    "build:mobile": "cd mobile && npm run build",
    "install:all": "npm install && cd client && npm install && cd ../mobile && npm install",
    "test": "jest",
    "lint": "eslint ."
  },
  "keywords": ["travel", "flight", "hotel", "ai", "mobile"],
  "author": "JT Tech",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "axios": "^1.5.0",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.4",
    "stripe": "^13.5.0",
    "joi": "^17.9.2",
    "helmet": "^7.0.0",
    "express-rate-limit": "^6.10.0",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.6.4",
    "eslint": "^8.48.0",
    "supertest": "^6.3.3"
  }
}