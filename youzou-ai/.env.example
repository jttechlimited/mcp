# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=youzou_ai
DB_USER=postgres
DB_PASSWORD=your_password_here

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_RESET_SECRET=your_password_reset_secret_here
JWT_EMAIL_SECRET=your_email_verification_secret_here

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password_or_app_password

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# API Keys for Travel Services
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
SKYSCANNER_API_KEY=your_skyscanner_api_key
BOOKING_COM_API_KEY=your_booking_com_api_key
EXPEDIA_API_KEY=your_expedia_api_key
HOTELS_COM_API_KEY=your_hotels_com_api_key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Mobile App Configuration
EXPO_GOOGLE_ANDROID_CLIENT_ID=your_expo_google_android_client_id
EXPO_GOOGLE_IOS_CLIENT_ID=your_expo_google_ios_client_id

# Admin Panel Configuration
ADMIN_EMAIL=admin@youzou-ai.com
ADMIN_DEFAULT_PASSWORD=change_this_password

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_here

# Notification Settings
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# File Upload
MAX_FILE_SIZE=5242880  # 5MB
UPLOAD_DIR=uploads

# Search Configuration
MAX_SEARCH_RESULTS=50
SEARCH_CACHE_TTL=300000  # 5 minutes
DEFAULT_CURRENCY=HKD
DEFAULT_LANGUAGE=zh-TW

# Points System
FREE_USER_DAILY_POINTS=10
FREE_USER_SIGNUP_POINTS=100
PRO_USER_MONTHLY_POINTS=1000
PRO_USER_DAILY_POINTS=50
SEARCH_COST_MULTIPLIER=10
AUTO_CHECKER_COST=5

# Subscription Plans
PRO_PLAN_PRICE_ID=your_stripe_price_id_for_pro_plan
PRO_PLAN_PRICE=299  # HKD per month